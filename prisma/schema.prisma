generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id
  name          String?
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  presentations Presentation[]
  usageEvents   UsageEvent[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Presentation {
  id          String   @id @default(cuid())
  title       String
  totalSlides Int
  /// Theme id from lib/theme.ts (named themeColors for historical reasons).
  themeColors String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slides      Slide[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([userId, createdAt])
}

model Slide {
  id             String       @id @default(cuid())
  title          String
  subtitle       String
  imgUrl         String?
  slidenumber    Int
  slideLayout    String?
  content        String[]
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([presentationId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum UsageKind {
  DECK
  IMAGE
}

enum UsageStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One row per generation request. Rows are written *before* calling the AI
/// provider (reserving quota), so failed generations still count.
model UsageEvent {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       UsageKind
  status     UsageStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  finishedAt DateTime?

  @@index([userId, createdAt])
  @@index([userId, status])
}
