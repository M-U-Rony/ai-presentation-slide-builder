# Required
DATABASE_URL= # PostgreSQL connection string
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app
OPENROUTER_API_KEY=
TEXT_GENERATION_MODEL= # OpenRouter model id for slide text (old name Text_Generation_Model still works)
IMAGE_GENERATION_MODEL= # OpenRouter model id for slide images (old name Image_Generation_Model still works)

# Optional: GitHub sign-in is enabled only when both are set
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
